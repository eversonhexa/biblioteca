# ==========================================================
# Aula 7 — modelo do arquivo de variáveis de ambiente
#
# Copie este arquivo para um novo arquivo chamado ".env"
# (na mesma pasta) e preencha com os valores reais do SEU
# MySQL. O arquivo ".env" nunca é enviado para o Git nem
# compartilhado — cada pessoa tem o seu, com sua própria
# senha (veja o .gitignore).
# ==========================================================

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=coloque_aqui_a_senha_do_seu_mysql
DB_NAME=biblioteca_escolar

PORT=3000

# Aula 11 — chave usada pelo express-session para assinar o
# cookie de sessão. Pode ser qualquer texto longo e difícil de
# adivinhar; troque pelo valor que quiser no seu .env.
SESSION_SECRET=troque-por-um-texto-longo-e-dificil-de-adivinhar
